# Copy this file to .env.local and fill in the values from your EmailJS dashboard.
# Only the EmailJS PUBLIC key belongs here; no private key or email password is needed.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Enable when the Vercel Web Analytics plan supports custom events.
NEXT_PUBLIC_VERCEL_INQUIRY_EVENTS=false
